+    @SmallTest
+    @Test
+    public void testRuntimeFontFallbackCannotCreatePlaceholderCycle() throws Exception {
+        Typeface concrete = Typeface.create("sans-serif", Typeface.NORMAL);
+        long expected = concrete.getNativeInstance();
+        Map<String, Typeface> fonts = new HashMap<>();
+        fonts.put("sans-serif", concrete);
+        Typeface first = new Typeface(Typeface.NORMAL, 400, "sans-serif");
+        Typeface.initializePendingTypefaceLocked(first, "sans-serif", fonts);
+        Typeface second = new Typeface(Typeface.NORMAL, 400, "sans-serif");
+        Typeface.initializePendingTypefaceLocked(second, "sans-serif", fonts);
+        java.lang.reflect.Method update = Typeface.class.getDeclaredMethod(
+                "updatePendingTypeface", Typeface.class);
+        update.setAccessible(true);
+        // The default-font fallback may be the very placeholder being updated.
+        assertEquals(true, update.invoke(first, first));
+        assertEquals(expected, first.getNativeInstance());
+        for (int i = 0; i < 100; i++) {
+            update.invoke(first, second);
+            update.invoke(second, first);
+        }
+        assertEquals(expected, first.getNativeInstance());
+        assertEquals(expected, second.getNativeInstance());
+        Paint paint = new Paint();
+        paint.setTypeface(first);
+        assertTrue(paint.measureText("Quilt font fallback") > 0);
