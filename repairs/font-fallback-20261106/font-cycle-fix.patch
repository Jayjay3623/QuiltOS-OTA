+    // Snapshot the concrete font before changing any public placeholder. A fallback can be
+    // DEFAULT or SANS_SERIF itself; storing that placeholder would create a reference cycle.
+    private static Typeface resolveConcreteTypeface(@NonNull Typeface typeface) {
+        if (typeface.mPendingTypeface == null) {
+            return typeface;
+        }
+        java.util.IdentityHashMap<Typeface, Boolean> visited = new java.util.IdentityHashMap<>();
+        while (typeface.mPendingTypeface != null) {
+            if (visited.put(typeface, Boolean.TRUE) != null) {
+                throw new IllegalStateException("Cyclic pending Typeface reference.");
+            }
+            typeface = typeface.mPendingTypeface.get();
+            if (typeface == null) {
+                throw new IllegalStateException("The Typeface is not fully initialized.");
+            }
+        }
+        return typeface;
     }
 
